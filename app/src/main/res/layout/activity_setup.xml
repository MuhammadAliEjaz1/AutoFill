<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Setup guide"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/maker_line"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvServiceState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Service is OFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Step 1: Turn on the AutoFiller service.\nTap the button below, find AutoFiller in the list (it may be under Downloaded apps or Installed services), switch it ON and tap OK or Allow."
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go to Accessibility Settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Step 2 (Android 13 or newer only): If the switch is grey or says Restricted setting, tap the button below, then tap the three dots at the top right, tap Allow restricted settings, and repeat Step 1."
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open App info" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Step 3: About the Play Protect warning.\nThis app is not on the Play Store, so Google Play Protect may show a warning when you install it. Tap More details, then Install anyway. AutoFiller has no internet permission: your CSV and the form data never leave your phone."
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Step 4: No storage permission is needed. You choose the CSV file yourself with the Select CSV file button."
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/maker_line"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
